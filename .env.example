# Slack — create an app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
# HTTP mode (Events API): required for request URL verification
SLACK_SIGNING_SECRET=<SLACK_SIGNING_SECRET>
# Socket Mode (easier for local dev): use instead of public HTTPS
SLACK_APP_TOKEN=<SLACK_APP_TOKEN>

# Ollama — local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Optional: Web search (Tavily). If unset, DuckDuckGo Instant Answer is used.
TAVILY_API_KEY=<TAVILY_API_KEY>

# Optional: Laminar (evals / tracing)
# Preferred env var name (Laminar CLI expects this):
LMNR_PROJECT_API_KEY=<LMNR_PROJECT_API_KEY>
# Back-compat fallback (we also read this in code):
LMNR_API_KEY=<LMNR_API_KEY>

# HTTP receiver (when not using Socket Mode)
PORT=3000
SERPAPI_API_KEY=<SERPAPI_API_KEY>
OLLAMA_REASONING_MODEL=<OLLAMA_REASONING_MODEL>
SERPER_API_KEY=<SERPER_API_KEY>