# Slack — create an app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
# HTTP mode (Events API): required for request URL verification
SLACK_SIGNING_SECRET=<SLACK_SIGNING_SECRET>
# Socket Mode (easier for local dev): use instead of public HTTPS
SLACK_APP_TOKEN=<SLACK_APP_TOKEN>

# Ollama — local or https://ollama.com (Bearer key for Cloud)
# Cloud: model must exist on ollama.com (llama3.2 is often NOT available). List with:
#   curl -s -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
# Then set OLLAMA_MODEL to one of those names (e.g. gpt-oss:20b, ministral-3:3b).
# Local: ollama pull llama3.2:latest  →  OLLAMA_BASE_URL=http://127.0.0.1:11434  (no API key)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=<OLLAMA_API_KEY>
OLLAMA_MODEL=<OLLAMA_MODEL>

# HTTP receiver (when not using Socket Mode)
# HTTP receiver (when not using Socket Mode)
PORT=3000
SERPAPI_API_KEY=<SERPAPI_API_KEY>
OLLAMA_REASONING_MODEL=<OLLAMA_REASONING_MODEL>
SERPER_API_KEY=<SERPER_API_KEY>